# 复制为 .env（Compose）或 .env.local（本地开发）。配置在启动时读取，不使用构建参数。
#
# --- 本地开发 ---
# 先启动 PostgreSQL，再分别运行 `npm run dev:api` 与 `npm run dev`。
# Vite 开发服务器把 /api 代理到 Go API，生产由 Go 同源托管静态 SPA。
# DATABASE_URL=postgres://genealogy:change-me@127.0.0.1:5432/genealogy?sslmode=disable
# API_HOST=127.0.0.1
# API_PORT=8080
# DEV_API_PROXY_TARGET=http://127.0.0.1:8080
# APP_ORIGIN 用于写请求的来源校验，多个来源用逗号分隔（localhost 与 127.0.0.1 不同源）
# APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# FAMILY_SURNAME=刘
# ALLOW_SIGNUP=true
# 成员照片存储目录（相对路径以 backend/ 为基准）
# PHOTO_STORAGE_DIR=data/photos
# PHOTO_MAX_BYTES=10485760
# PHOTO_THUMBNAIL_MAX_EDGE=480
#
# --- Compose ---
# Compose 中的数据库主机名是 db，应用容器监听 8080，宿主机默认映射到 3000。
SITE_URL=http://localhost:3000
APP_PORT=3000
BIND_ADDRESS=0.0.0.0
GENEALOGY_IMAGE=ghcr.io/jeege/genealogy:latest

POSTGRES_DB=genealogy
POSTGRES_USER=genealogy
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://genealogy:change-me@db:5432/genealogy?sslmode=disable

FAMILY_SURNAME="刘"
SESSION_TTL=720h
COOKIE_SECURE=auto
# 自托管建议关闭公开注册，通过 ADMIN_* 或 user create 命令创建账号。
# 用户名不限制字符（中文、空格、符号均可），登录时不区分大小写。
# 本地开发可改为 true 以注册第一个账号；生产环境建议保持 false。
ALLOW_SIGNUP=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
LOG_LEVEL=info
# 成员照片：容器内路径固定为 /data/photos，由 photo-data 卷持久化。
PHOTO_MAX_BYTES=10485760
PHOTO_THUMBNAIL_MAX_EDGE=480
