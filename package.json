{
  "name": "pure-genealogy",
  "version": "0.1.0",
  "description": "A genealogy web application built with React, Vite, Go, and PostgreSQL.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/run-backend.mjs serve",
    "test": "npm run test:web && npm run test:go",
    "test:web": "node --test tests/*.test.mjs",
    "test:go": "node scripts/go.mjs test ./...",
    "test:import": "node --test tests/member-import.test.mjs",
    "db:migrate": "node scripts/run-backend.mjs migrate",
    "build": "tsc --noEmit && vite build && node scripts/copy-web.mjs",
    "build:binary": "npm run build && node scripts/go.mjs build -o ../pure-genealogy ./cmd/server",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/dagre": "^0.7.53",
    "@types/three": "0.182.0",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "is-hotkey": "^0.2.0",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-force-graph-3d": "^1.29.0",
    "react-router-dom": "^7",
    "recharts": "^3.6.0",
    "slate": "^0.120.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.120.0",
    "tailwind-merge": "^3.3.0",
    "three": "0.182.0",
    "three-spritetext": "^1.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/is-hotkey": "^0.1.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8",
    "shadcn": "^3.6.2",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5"
  }
}
